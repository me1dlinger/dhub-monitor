# Display name shown in the UI
APP_NAME=Docker Hub Monitor

# Access key. Leave empty to disable authentication (NOT recommended in public
# networks). Use a long random value, e.g. `openssl rand -hex 24`.
AUTH_SECRET=

# Hours between automatic refreshes (scheduler)
REFRESH_INTERVAL=6

# Optional crontab expression (5 fields) that overrides REFRESH_INTERVAL, e.g.
# "0 */2 * * *" for every 2 hours on the hour.
# When REFRESH_INTERVAL divides 24 evenly, refreshes already fire on the hour.
# REFRESH_CRON=

# Run the scheduler inside the web process. Default true (simple for local
# development). Set false when a dedicated scheduler process runs (Docker does
# this automatically), or you would run two schedulers.
# EMBEDDED_SCHEDULER=true

# Default chart range in the dashboard, in days
DEFAULT_DAYS=14

# Web server bind address
PORT=5000
HOST=0.0.0.0

# Collector tuning
FETCH_WORKERS=4
REQUEST_TIMEOUT=20
TAGS_CACHE_TTL=21600

# Docker Hub authentication (optional). A Personal Access Token raises the rate
# limit and reduces throttling, but does not bypass a network block.
# DOCKER_HUB_TOKEN=

# Docker Hub metadata endpoint (optional override for a self-hosted gateway)
# DOCKER_HUB_API=https://hub.docker.com/v2/repositories

# Login brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Outbound proxy for Docker Hub (leave empty to connect directly)
# HTTP_PROXY=http://192.168.31.173:7890
# HTTPS_PROXY=http://192.168.31.173:7890
# NO_PROXY=localhost,127.0.0.1
